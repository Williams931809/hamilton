rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /site-media/{file} {
   allow read: if true;
   allow write: if request.auth != null
    && firestore.exists(/databases/(default)/documents/siteAdmins/$(request.auth.uid))
    && request.resource.size < 50 * 1024 * 1024
    && request.resource.contentType.matches('image/.*|video/mp4|video/webm');
  }
 }
}