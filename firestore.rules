rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(){return signedIn() && exists(/databases/$(database)/documents/siteAdmins/$(request.auth.uid));}
  match /siteConfig/bootstrap {
   allow create: if signedIn() && !exists(/databases/$(database)/documents/siteConfig/bootstrap)
     && request.resource.data.ownerUid == request.auth.uid
     && getAfter(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data.uid == request.auth.uid;
   allow read,update,delete: if false;
  }
  match /siteAdmins/{uid} {
   allow create: if signedIn() && uid == request.auth.uid
     && !exists(/databases/$(database)/documents/siteConfig/bootstrap)
     && request.resource.data.uid == uid
     && getAfter(/databases/$(database)/documents/siteConfig/bootstrap).data.ownerUid == uid;
   allow read: if signedIn() && (request.auth.uid == uid || admin());
   allow update,delete: if false;
  }
  match /siteContent/{id} {
   allow read: if admin() || resource.data.published == true;
   allow create,update,delete: if admin();
  }
  match /enquiries/{id} {
   allow create: if request.resource.data.keys().hasOnly(['name','email','topic','message','createdAt'])
    && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 200
    && request.resource.data.email is string && request.resource.data.email.size() <= 320
    && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 5000;
   allow read,update,delete: if admin();
  }
 }
}